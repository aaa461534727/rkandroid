# ============================================================================
# rkandroid —— 只收「源码的定义 + 板级叠加层」，源码本体与固件一律不进仓
# ============================================================================

# 编译产物 / 镜像 / 打包中间物
out/
rockdev/
*.img
*.ota
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# 厂商无线固件二进制（授权文件，不得公开；版本靠 src/firmware/*/md5.txt 认）
*.bin

# 内核 / 驱动编译中间物与被跟踪的模块
*.ko
*.o
*.o.d
*.order
*.symvers
*.a

# 大体积二进制（含闭源 so / apk / 预编译工具）
*.so
*.so.*
*.apk
*.jar
*.dll
*.dylib

# 编辑器 / 系统垃圾
*~
*.swp
*.swo
.DS_Store
*.orig
*.rej

# repo / git 元数据（不该出现在子目录里）
.repo/
